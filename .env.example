# ── Database (Postgres) ─────────────────────────────
POSTGRES_USER=goeye
POSTGRES_PASSWORD=pick-a-strong-password
POSTGRES_DB=goeye
DATABASE_URL=postgresql+asyncpg://goeye:pick-a-strong-password@localhost:5432/goeye

# ── Redis ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# TRACK_STREAM=tracks
# EVENT_STREAM=events

# ── Auth ────────────────────────────────────────────
JWT_SECRET=paste-generated-secret-here
CORS_ORIGINS=["http://localhost:5173"]
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_MINUTES=720

# ── Cameras ─────────────────────────────────────────
# Camera id -> RTSP URL without the login (the login is added from RTSP_USER / RTSP_PASSWORD)
CAMERAS={"cam1501":"rtsp://10.0.0.93:554/streaming/channels/1501","cam1601":"rtsp://10.0.0.93:554/streaming/channels/1601"}
RTSP_USER=your-nvr-username
RTSP_PASSWORD=your-nvr-password

# Optional tuning (defaults shown)
# CAMERA_TIMEOUT_SECONDS=10
# CAMERA_RECONNECT_SECONDS=3
# STREAM_FPS=10
# STREAM_JPEG_QUALITY=80
# FRAME_TTL_SECONDS=5
# Person detection (defaults shown)
# MODELS_DIR=models
# YOLO_MODEL=yolo26l.pt
# DETECT_CONF=0.1
# DETECT_IMGSZ=640
# ANALYSIS_FPS=5
# Staff recognition (defaults shown)
# STAFF_MODEL=staff_cls.pt
# STAFF_THRESHOLD=0.5